# ORDEM DE CRIAÇÃO: 2º (Etapa 2 — configuração)
#
# POR QUE EXISTE:
#   O código precisa de valores que mudam de máquina para máquina e que não
#   devem ir para o Git (credenciais). Este arquivo é o MODELO: ele vai para o
#   Git, o ".env" real (com seus valores) NÃO vai — já está no .gitignore.
#   Quem clonar o projeto copia este arquivo para ".env" e preenche.
#
# COMO USAR:
#   cp .env.example .env
#
# ONDE OS VALORES DO SPOTIFY VÊM:
#   https://developer.spotify.com/dashboard -> seu app -> Settings

# Identificador público do app no Spotify. Com PKCE NÃO precisamos de client secret.
SPOTIFY_CLIENT_ID=

# Tem que ser IDÊNTICO ao cadastrado no dashboard (o Spotify não aceita "localhost").
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8080/callback

# Porta do nosso servidor.
PORT=8080

# Endereço do front-end (outro projeto). Para onde o /callback redireciona
# o browser depois do login.
FRONTEND_URL=http://127.0.0.1:5173

# Origem que o CORS vai permitir (normalmente a mesma do front-end).
# Atenção: "localhost" e "127.0.0.1" são origens DIFERENTES para o browser.
CORS_ALLOWED_ORIGIN=http://127.0.0.1:5173

# Fuso usado para decidir "em que dia" uma música foi ouvida (played_at vem em UTC).
TIMEZONE=America/Sao_Paulo

# De quantos em quantos minutos o coletor consulta o histórico (etapa 9).
COLLECT_INTERVAL_MINUTES=20

# Conexão com o PostgreSQL: guarda o token do Spotify e o histórico de plays.
# Formato: postgres://USUARIO:SENHA@HOST:PORTA/BANCO?sslmode=disable
#   - sslmode=disable só é aceitável em localhost;
#   - se a senha tiver @ : / ? precisa de escape (percent-encoding);
#   - NÃO commite a senha real: ela vai só no seu .env (ignorado pelo Git).
# Sugestão: crie um banco dedicado (CREATE DATABASE sgotify;) em vez de usar
# o banco padrão "postgres".
DB_URL=postgres://USUARIO:SENHA@localhost:5432/sgotify?sslmode=disable

# --- Autenticação das rotas /api/* ---------------------------------------------
# O login do Spotify (/login) é a identidade: só a conta abaixo recebe o cookie
# de sessão que libera /api/*. Outra conta é recusada e NÃO sobrescreve o token.
#
# Seu id do Spotify: no app, perfil -> "..." -> Compartilhar -> Copiar link.
# O link é https://open.spotify.com/user/ESTE_TRECHO?si=... (o id é o trecho
# depois de /user/). Atalho: deixe qualquer valor, faça o login em /login e o
# servidor escreve no log "login rejected: spotify user "<id>" ..." com o seu id.
ALLOWED_SPOTIFY_USER_ID=

# Chave que assina o cookie de sessão. OBRIGATÓRIA, com no mínimo 32 caracteres,
# aleatória e secreta (quem a conhecer forja sessões). Trocar o valor desloga
# todo mundo. Para gerar:
#   bash:       openssl rand -base64 32
#   PowerShell: [Convert]::ToBase64String([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
SESSION_SECRET=

# (Testes de integração) TEST_DB_URL NÃO é lida do .env: defina-a como variável de
# ambiente só ao rodar os testes, apontando para um banco SEPARADO
# (CREATE DATABASE sgotify_test;). Os testes apagam linhas: nunca use o banco real.
# Sem ela, os testes de integração são pulados (t.Skip). Veja o guide-structure.md, seção 12.
#   bash:       TEST_DB_URL='postgres://USUARIO:SENHA@localhost:5432/sgotify_test?sslmode=disable' go test ./...
#   PowerShell: $env:TEST_DB_URL = '...'; go test ./...
