# ORDEM DE CRIAÇÃO: 2º (Etapa 2 — configuração)
#
# POR QUE EXISTE:
#   O código precisa de valores que mudam de máquina para máquina e que não
#   devem ir para o Git (credenciais). Este arquivo é o MODELO: ele vai para o
#   Git, o ".env" real (com seus valores) NÃO vai — já está no .gitignore.
#   Quem clonar o projeto copia este arquivo para ".env" e preenche.
#
# COMO USAR:
#   cp .env.example .env
#
# ONDE OS VALORES DO SPOTIFY VÊM:
#   https://developer.spotify.com/dashboard -> seu app -> Settings

# Identificador público do app no Spotify. Com PKCE NÃO precisamos de client secret.
SPOTIFY_CLIENT_ID=

# Tem que ser IDÊNTICO ao cadastrado no dashboard (o Spotify não aceita "localhost").
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8080/callback

# Porta do nosso servidor.
PORT=8080

# Endereço do front-end (outro projeto). Para onde o /callback redireciona
# o browser depois do login.
FRONTEND_URL=http://127.0.0.1:5173

# Origem que o CORS vai permitir (normalmente a mesma do front-end).
# Atenção: "localhost" e "127.0.0.1" são origens DIFERENTES para o browser.
CORS_ALLOWED_ORIGIN=http://127.0.0.1:5173

# Fuso usado para decidir "em que dia" uma música foi ouvida (played_at vem em UTC).
TIMEZONE=America/Sao_Paulo

# De quantos em quantos minutos o coletor consulta o histórico (etapa 9).
COLLECT_INTERVAL_MINUTES=20

# Onde guardamos token.json e plays.json.
DATA_DIR=data
